# Copy to .env; never commit .env or your Adobe workspace download.
# Populate Adobe values using aio app use / aio app add service.
LOG_LEVEL=info
# Build-time association workaround; false restores SDK OpenAPI discovery.
AZUPAY_APP_CONFIG_COMPATIBILITY=true
# Opt in only if a legacy registry rejects webhook discovery. Installer hooks stay enabled.
AZUPAY_APP_CONFIG_OMIT_WEBHOOKS=false
# Imported by aio app use from the selected Adobe workspace.
AIO_runtime_namespace=
AIO_runtime_auth=
AIO_COMMERCE_AUTH_IMS_CLIENT_ID=
AIO_COMMERCE_AUTH_IMS_CLIENT_SECRETS=
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_ID=
AIO_COMMERCE_AUTH_IMS_TECHNICAL_ACCOUNT_EMAIL=
AIO_COMMERCE_AUTH_IMS_ORG_ID=
AIO_COMMERCE_AUTH_IMS_SCOPES=

# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable across deploys; rotating invalidates outstanding checkout receipts.
AZUPAY_SIGNING_SECRET=
AZUPAY_ALLOW_PRODUCTION=false
# Exact HTTPS storefront origins, comma separated; no paths or wildcard.
AZUPAY_STOREFRONT_ORIGINS=https://your-store.example
# Required for hosted checkout: comma separated exact Azupay hostnames.
# Get the UAT and production hosts from Azupay; never add your storefront here.
AZUPAY_CHECKOUT_HOSTS=pay.azupay.com.au,pay-uat.azupay.com.au

# Only populate profiles you have provisioned. Each client must have its hosted
# experience configured in Azupay Dashboard: Apps > Pay by Bank / Checkout.
# Use SECR keys with least-privilege PaymentRequest create/read permissions.
AZUPAY_UAT_PAYID_CLIENT_ID=
AZUPAY_UAT_PAYID_API_KEY=
AZUPAY_UAT_PAYTO_CLIENT_ID=
AZUPAY_UAT_PAYTO_API_KEY=
AZUPAY_UAT_BOTH_CLIENT_ID=
AZUPAY_UAT_BOTH_API_KEY=
AZUPAY_PRODUCTION_PAYID_CLIENT_ID=
AZUPAY_PRODUCTION_PAYID_API_KEY=
AZUPAY_PRODUCTION_PAYTO_CLIENT_ID=
AZUPAY_PRODUCTION_PAYTO_API_KEY=
AZUPAY_PRODUCTION_BOTH_CLIENT_ID=
AZUPAY_PRODUCTION_BOTH_API_KEY=
